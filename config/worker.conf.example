# Copy to worker.conf on a new Worker; fill the server address and production paths.
network.server_ip=127.0.0.1
server.port=8080
network.timeout_ms=5000
worker.slots=1
worker.output_dir=./worker-output
worker.output_root=./worker-output
worker.slots_root=./worker/workers_slots
worker.checkout_parallelism=1
worker.svn_url=
worker.svn_revision=
worker.artifact_root=
worker.clean=true
worker.terminate_grace_seconds=30
worker.reconnect_seconds=2
log.retention_days=30
smoke.report_dir=./intranet-report
